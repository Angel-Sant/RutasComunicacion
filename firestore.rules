rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function coordinacion() {
      return request.auth != null
        && request.auth.token.email in [
             'miguel.santana.mon@bilbao.edu.mx',
             'coordinacion@bilbao.edu.mx'
           ];
    }

    function auxiliar() {
      return request.auth != null
        && request.auth.token.email.matches('ruta[0-9]+@bilbao[.]edu[.]mx');
    }

    function personal() { return coordinacion() || auxiliar(); }

    // Lista de alumnos, rutas, familias y cambios del día.
    match /transporte/datos {
      allow read: if personal();
      allow write: if coordinacion();
    }

    // Recorridos cerrados.
    match /bitacora/{id} {
      allow create: if personal();
      allow read: if coordinacion();
      allow update, delete: if false;
    }

    // Lo que ve cada familia. El código es la llave.
    match /familias/{codigo}/dias/{id} {
      allow read: if request.auth != null;
      allow create, update: if personal();
      allow delete: if coordinacion();
    }

    // "Hoy no sube" de la tarde, registrado por los papás.
    // Se puede leer uno por uno (los papás ven el suyo), pero
    // solo el personal puede listarlos todos.
    // Marca de que una familia ya usó la app, para saber a quién falta invitar.
    match /familias/{codigo}/acceso/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if coordinacion();
    }

    match /bajas/{id} {
      allow get: if request.auth != null;
      allow list: if personal();
      allow create, update: if request.auth != null;
      allow delete: if personal();
    }

    // Solicitudes de cambio de ruta o de lugar de entrega.
    // Los papás crean y consultan la suya; solo coordinación resuelve.
    match /solicitudes/{id} {
      allow get: if request.auth != null;
      allow list: if personal();
      allow create: if request.auth != null;
      allow update: if coordinacion()
                    || (request.auth != null
                        && resource.data.estado == 'pendiente'
                        && request.resource.data.estado == 'cancelada');
      allow delete: if coordinacion();
    }

    // Pase de lista de la salida y liberación de la ruta.
    // La auxiliar la crea y pide liberar; solo coordinación libera.
    match /salidas/{id} {
      allow read: if personal();
      allow create, update: if personal();
      allow delete: if coordinacion();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
