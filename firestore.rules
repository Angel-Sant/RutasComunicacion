rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuentas de coordinación: leen y editan todo.
    // Para sumar a alguien más, agrega su correo a esta lista.
    function coordinacion() {
      return request.auth != null
        && request.auth.token.email in [
             'miguel.santana.mon@bilbao.edu.mx',
             'coordinacion@bilbao.edu.mx'
           ];
    }

    // Cuentas de las auxiliares: ruta1@bilbao.edu.mx ... ruta6@bilbao.edu.mx
    // Ningún otro correo del colegio entra por aquí: solo los que empiezan con "ruta" y un número.
    function auxiliar() {
      return request.auth != null
        && request.auth.token.email.matches('ruta[0-9]+@bilbao[.]edu[.]mx');
    }

    // La lista de alumnos, rutas y cambios del día.
    // Las auxiliares la leen; solo coordinación la modifica.
    match /transporte/datos {
      allow read: if coordinacion() || auxiliar();
      allow write: if coordinacion();
    }

    // Cada recorrido cerrado. Las auxiliares solo pueden agregar,
    // nunca leer lo de otras rutas ni borrar.
    match /bitacora/{id} {
      allow create: if auxiliar() || coordinacion();
      allow read: if coordinacion();
      allow update, delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
